# PostgreSQL connection string
DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms"

# Secret used to sign login sessions (run: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# P6 (optional): Firebase service-account JSON for FCM pushes to the HRMate app.
# Paste the JSON (or base64 of it). Leave empty to disable push — the in-app bell still works.
FCM_SERVICE_ACCOUNT=""
