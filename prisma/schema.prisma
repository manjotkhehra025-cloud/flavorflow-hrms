generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Multi-tenant-ready foundation ----------
// v1 runs a single company (FlavorFlow), but every record carries a companyId,
// so converting to a multi-company SaaS later = add sign-up + per-tenant filtering.

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // e.g. "FF"
  letterSeq Int      @default(0)
  createdAt DateTime @default(now())

  users               User[]
  employees           Employee[]
  permissions         EmployeePermission[]
  departments         Department[]
  designations        Designation[]
  attendances         Attendance[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  holidays            Holiday[]
  shifts              Shift[]
  gatePasses          GatePass[]
  // Phase E3/E4: pay rules
  dailyPaidLeaveDays  Int                  @default(0)
  lateGraceMins       Int                  @default(15)
  latesPerCut         Int                  @default(0)
  punchSelfieRequired Boolean              @default(false)
  // Phase G: DA + OT-rate rules
  daPercent           Int                  @default(0) // dearnee allowance % of earned basic (monthly staff)
  otMultiplier        Float                @default(1.5)
  shiftHours          Float                @default(9) // hours in one full paid day (OT rate base)
  // Phase F2: factory geofence punch
  geofenceEnabled     Boolean              @default(false)
  geoLat              Float?
  geoLng              Float?
  geoRadius           Float                @default(200) // metres
  geoFacility         String? // e.g. "G.D. Foods Mfg. (I) Pvt. Ltd."
  geoAddress          String? // reverse-geocoded address text
  punchRequests       PunchRequest[]
  letters             Letter[]
  leaveAdjustments    LeaveAdjustment[]
  kraCycles           KraCycle[]
  tickets             Ticket[]
  starAwards          StarAward[]
  advances            Advance[]
  payrollRuns         PayrollRun[]
  shiftAssignments    ShiftAssignment[]
  payslipLinks        PayslipLink[]
  letterLinks         LetterLink[]
  socialPosts         SocialPost[]
  kycDocs             KycDoc[]
  shiftSwapRequests   ShiftSwapRequest[]
  pushTokens          PushToken[]
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

model SocialPost {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  likes    PostLike[]
  comments PostComment[]

  @@index([companyId, createdAt])
}

model PostLike {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())

  @@index([postId])
}

model ShiftSwapRequest {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterId String
  requester   Employee      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  peerId      String
  peer        Employee      @relation("SwapPeer", fields: [peerId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  note        String?
  status      RequestStatus @default(PENDING)
  approverId  String?
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([companyId, status])
}

model KycDoc {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType    String // AADHAAR | PAN | BANK | ESIC | MEDICAL | OTHER
  refNumber  String
  filePath   String?
  createdAt  DateTime @default(now())

  @@index([companyId, employeeId])
}

model User {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  locale             String    @default("en") // "en" | "pa" — per-user UI language
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
  socialPosts    SocialPost[]
  postLikes      PostLike[]
  postComments   PostComment[]
  pushTokens     PushToken[]

  @@index([companyId])
}

model Department {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?
  parent         Department?  @relation("SubDepartments", fields: [parentId], references: [id], onDelete: SetNull)
  subDepartments Department[] @relation("SubDepartments")

  employees    Employee[]
  designations Designation[]

  @@unique([companyId, name])
}

model Designation {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  // Which staff type typically holds this title; BOTH when generic (e.g. Manager).
  category     DesignationCategory @default(BOTH)
  // Optional home department (e.g. "Lab Assistant" under Quality).
  departmentId String?
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  employees Employee[]

  @@unique([companyId, title])
}

model EmployeePermission {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String   @unique
  canPunch       Boolean  @default(true)
  canApplyLeave  Boolean  @default(true)
  canGatePass    Boolean  @default(true)
  canSwapShift   Boolean  @default(true)
  canSocialPost  Boolean  @default(true)
  canViewPayslip Boolean  @default(true)

  @@index([companyId])
}

enum DesignationCategory {
  OFFICIAL
  YELLOW_CARD
  BOTH
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum StaffCategory {
  OFFICIAL
  YELLOW_CARD
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String // FF-001
  firstName      String
  lastName       String
  email          String?
  phone          String?
  gender         String?
  dateOfBirth    DateTime?      @db.Date
  bloodGroup     String? // e.g. "AB+"
  emergencyName  String?
  emergencyPhone String?
  joinDate       DateTime       @db.Date
  address        String?
  status         EmployeeStatus @default(ACTIVE)
  photoUrl       String?
  photoExt       String?
  category       StaffCategory  @default(OFFICIAL)
  contractor     String? // contractor / thekedari grouping (Phase E5)
  weeklyOff      Int            @default(0) // JS getUTCDay(): 0=Sun ... 6=Sat
  // Phase D: payroll setup
  salaryType     String         @default("MONTHLY") // MONTHLY | DAILY
  baseSalary     Int? // ₹ per month (whole rupees)
  dailyRate      Int? // ₹ per day
  otRate         Int? // ₹ per hour (null → auto from base / 26 / 9)
  bankAccount    String?
  ifsc           String?
  // Phase D4: statutory
  pfEnabled      Boolean        @default(false)
  pfNumber       String? // UAN
  esiEnabled     Boolean        @default(false)
  esiNumber      String? // IP / insurance number
  shiftId        String?
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  managerId     String?
  manager       Employee?    @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports       Employee[]   @relation("Reports")

  users            User[]
  permission       EmployeePermission?
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  gatePasses       GatePass[]
  punchRequests    PunchRequest[]
  letters          Letter[]
  leaveAdjustments LeaveAdjustment[]
  kraGoals         KraGoal[]
  tickets          Ticket[]
  starAwards       StarAward[]
  advances         Advance[]
  kycDocs          KycDoc[]
  swapRequestsOut  ShiftSwapRequest[]  @relation("SwapRequester")
  swapRequestsIn   ShiftSwapRequest[]  @relation("SwapPeer")
  payrollRows      PayrollRow[]
  salaryRevisions  SalaryRevision[]
  shiftAssignments ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

model Attendance {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  selfiePath String? // Phase E5: punch selfie (verify person, audit)
  punchLat   Float?
  punchLng   Float?
  punchDist  Float? // metres from factory gate at punch time (audit)
  note       String?

  @@unique([employeeId, date])
  @@index([companyId, date])
}

model LeaveType {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  daysPerYear Int     @default(12)

  requests LeaveRequest[]

  @@unique([companyId, name])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  days        Int
  halfDay     Boolean     @default(false) // single-day half leave (0.5 pay)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approverId  String?
  approver    User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([companyId, status])
  @@index([employeeId])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime @db.Date

  @@unique([companyId, date])
}

// ---------- Phase E2: salary revision history (pay audit) ----------
model SalaryRevision {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId     String
  effectiveDate DateTime @db.Date
  changeType    String // CREATE | RAISE | DEMOTE | MODEL_SWITCH | REVISION
  oldSalaryType String?
  newSalaryType String?
  oldSalary     Int?
  newSalary     Int?
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([companyId, employeeId])
}

// ---------- Phase E3/E4/E5: pay rules & structure ----------
model ShiftAssignment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id])
  isOff      Boolean  @default(false) // explicit duty-off override

  @@unique([employeeId, date])
  @@index([companyId, date])
}

model PayslipLink {
  id        String     @id @default(cuid())
  token     String     @unique @default(cuid())
  rowId     String     @unique
  row       PayrollRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  companyId String
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  Company   Company    @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ---------- Phase D: payroll — advances, runs, rows ----------
// ---------- Phase E pay rules (Company columns) ----------
// dailyPaidLeaveDays: annual paid-leave quota for DAILY-rate workers (0 = not paid)
// lateGraceMins/latesPerCut: monthly staff — every N late-ins beyond grace = 1 LOP day (0 = rule off)

model Advance {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Int // ₹ given
  repaid      Int      @default(0) // ₹ recovered so far (monthly PayrollRow deductions)
  emi         Int? // fixed monthly recovery ₹; null = auto (25%-of-gross cap)
  givenDate   DateTime @db.Date
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, employeeId])
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  LOCKED
}

model PayrollRun {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month        String // "2026-09"
  status       PayrollRunStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  lockedById   String?
  lockedAt     DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  rows PayrollRow[]

  @@unique([companyId, month])
}

model PayrollRow {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payableDays Float @default(0) // present + weekly-off + holiday + approved leave (+ joined mid-month prorate)
  presentDays Float @default(0)
  absentDays  Float @default(0)
  leaveDays   Float @default(0)
  offDays     Float @default(0) // weekly-off + holidays
  lopDays     Float @default(0)

  baseAmount         Int          @default(0) // payable base in ₹
  otHours            Float        @default(0)
  otRate             Int          @default(0) // ₹/hr snapshot
  otAmount           Int          @default(0)
  deductions         Int          @default(0) // LOP as ₹ (monthly model)
  advanceRecover     Int          @default(0)
  otherDeduction     Int          @default(0)
  otherDeductionNote String?
  otherEarning       Int          @default(0)
  otherEarningNote   String?
  pfEmployee         Int          @default(0) // 12% of min(earned basic, 15000)
  pfEmployer         Int          @default(0) // employer share (company cost)
  esiEmployee        Int          @default(0) // 0.75% of gross (ex-OT)
  esiEmployer        Int          @default(0) // 3.25% (company cost)
  daAmount           Int          @default(0) // dearnee allowance ₹ (monthly staff, company daPercent)
  halfDays           Float        @default(0) // approved half-day leaves in month
  offWorkDays        Float        @default(0) // weekly-off/holiday days actually worked (payable extra for YELLOW_CARD)
  offWorkPay         Int          @default(0) // ₹ extra paid for those days
  netPay             Int          @default(0)
  paymentMode        String       @default("BANK") // BANK | CASH
  shareLink          PayslipLink?

  @@unique([runId, employeeId])
}

// ---------- HRMate v3: shifts, approvals hub, ID/gate pass ----------

model Shift {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String // "General Day Shift"
  startTime String // "08:00" (factory local, Asia/Kolkata)
  durationH Float   @default(9)

  employees       Employee[]
  ShiftAssignment ShiftAssignment[]

  @@unique([companyId, name])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GatePass {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  exitAt          String // "14:00"
  returnAt        String?
  reason          String?
  status          RequestStatus @default(PENDING)
  approverId      String?
  decidedAt       DateTime?
  entryVerifiedAt DateTime?
  createdAt       DateTime      @default(now())

  @@index([companyId, status])
  @@index([employeeId])
}

model PunchRequest {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date
  type       String // MANUAL_IN | MANUAL_OUT | OT
  time       String? // "08:53" for manual punches
  hours      Float? // OT hours
  reason     String?
  status     RequestStatus @default(PENDING)
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([companyId, status])
  @@index([employeeId])
}

model LeaveAdjustment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  days        Float // + = consumes balance (deduction), - = credits balance back
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model Letter {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serial     String   @unique // GDF/HR/2026/0007
  type       String // EXPERIENCE | JOINING | KYC
  issuedTo   String? // e.g. bank / verifier for KYC
  createdBy  String?
  createdAt  DateTime @default(now())
  links      LetterLink[]

  @@index([companyId, employeeId])
}

// Public (token-gated) share link for a letter — mirrors PayslipLink: the
// token opens the printable letterhead page, no login needed (bank/KYC use).
model LetterLink {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  letterId  String    @unique
  letter    Letter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  companyId String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  Company   Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ---------- Phase C1: KRA (quarterly, weightage + targets, auto-score) ----------

enum KraStatus {
  DRAFT
  OPEN
  SCORING
  CLOSED
}

model KraCycle {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  quarter   Int // 1-4
  status    KraStatus @default(DRAFT)
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  goals KraGoal[]

  @@unique([companyId, year, quarter])
}

model KraGoal {
  id         String   @id @default(cuid())
  cycleId    String
  cycle      KraCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  weight     Int // % — each employee's goals must sum to 100 before publish
  target     Float
  achieved   Float    @default(0)
  unit       String? // e.g. "cartons" / "days" / "%"
  hrNote     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cycleId])
  @@index([employeeId])
}

// ---------- Phase C2: Helpdesk tickets + Star of the Month ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  MACHINE
  SALARY
  UNIFORM
  CANTEEN
  SAFETY
  OTHER
}

model Ticket {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category       TicketCategory
  subject        String
  status         TicketStatus   @default(OPEN)
  employeeSeenAt DateTime?
  staffSeenAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  replies TicketReply[]

  @@index([companyId, status])
  @@index([employeeId])
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  isStaff    Boolean
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model StarAward {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // "2026-09"
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([companyId, month])
  @@index([employeeId])
}

/// P6: FCM device tokens for the Flutter app (one row per phone install).
model PushToken {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}
