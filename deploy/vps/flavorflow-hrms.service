[Unit]
Description=FlavorFlow HRMS API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=flavorflow
Group=flavorflow
WorkingDirectory=/opt/flavorflow-hrms-api/backend
EnvironmentFile=/etc/flavorflow-hrms.env
ExecStart=/usr/bin/python3 /opt/flavorflow-hrms-api/backend/server.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=flavorflow-hrms
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flavorflow-hrms

[Install]
WantedBy=multi-user.target
